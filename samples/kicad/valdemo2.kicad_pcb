(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.6)
  )

  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "B.Paste" user)
    (41 "F.Paste" user)
    (44 "Edge.Cuts" user)
  )

  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions true)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
    )
  )

  (net 0 "")
  (net 1 "VCC")
  (net 2 "GND")

  (footprint "test:tht" (layer "F.Cu")
    (at 100 100)
    (attr through_hole)
    (fp_text reference "J1" (at 0 -3) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_line (start -3 -2) (end 8 -2) (layer "F.SilkS") (width 0.12))
    (pad "1" thru_hole rect (at 0 0) (size 1.8 1.8) (drill 1.0)
      (layers "*.Cu" "*.Mask") (net 1 "VCC"))
    (pad "2" thru_hole circle (at 2.54 0) (size 1.8 1.8) (drill 1.0)
      (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "3" thru_hole oval (at 5.08 0) (size 1.8 2.2) (drill oval 1.0 1.4)
      (layers "*.Cu" "*.Mask") (net 2 "GND"))
  )

  (footprint "test:smd" (layer "F.Cu")
    (at 115 108)
    (attr smd)
    (pad "1" smd roundrect (at 0 0) (size 1.5 0.9) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25) (net 1 "VCC"))
    (pad "2" smd rect (at 3 0) (size 1.5 0.9) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "GND"))
  )

  (segment (start 100 100) (end 110 100) (width 0.3) (layer "F.Cu") (net 1))
  (segment (start 110 100) (end 115 108) (width 0.3) (layer "F.Cu") (net 1))
  (segment (start 102.54 100) (end 102.54 111) (width 0.25) (layer "F.Cu") (net 2))
  (segment (start 102.54 111) (end 118 111) (width 0.25) (layer "F.Cu") (net 2))
  (segment (start 118 111) (end 118 108) (width 0.25) (layer "F.Cu") (net 2))

  (via (at 110 100) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 1))
  (via (at 108 111) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 2))

  (zone (net 2) (net_name "GND") (layer "F.Cu") (name "gndpour")
    (hatch edge 0.5)
    (connect_pads (clearance 0.3))
    (min_thickness 0.25) (filled_areas_thickness no)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon
      (pts (xy 94 114) (xy 122 114) (xy 122 119) (xy 94 119))
    )
    (filled_polygon
      (layer "F.Cu")
      (pts
        (xy 94.25 114.25) (xy 121.75 114.25) (xy 121.75 118.75) (xy 94.25 118.75)
      )
    )
  )

  (gr_rect (start 90 92) (end 126 122) (layer "Edge.Cuts") (width 0.05) (fill none))
  (gr_circle (center 121 97) (end 123 97) (layer "Edge.Cuts") (width 0.05) (fill none))
)
