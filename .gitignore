/target

# egui_kittest transient snapshot artifacts (baselines *.png are committed)
crates/ui/tests/snapshots/*.new.png
crates/ui/tests/snapshots/*.diff.png
pcbforge-gerbers/

# Local scratch (job files, progress dashboard, logs, screenshots)
/local/

# App/agent state that must live in the repo root: the console reads and
# writes these beside the executable's cwd, and other agents read AGENTS.md
# from the root — ignored by name instead of moved.
/AGENTS.md
/pcbforge.sqlite
/pcbforge.console-settings
/logs/
/shots/
